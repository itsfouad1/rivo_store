{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rivo-store",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/login",
      "/register",
      "/recover",
      "/admin",
      "/account",
      "/confirm"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rivo_db",
      "database_id": "4190fb26-8a3d-49db-a6d3-9eb2f8fabaef",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "rivo-store-media"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *", "*/15 * * * *"]
  },
  "vars": {
    "SUPABASE_URL": "https://atgxzobzrnjazrgimqqy.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_JQf6jNZOY79JBNcswt2MUg_frTiEQ3-",
    "FOXRELOAD_LIVE_ENABLED": "false"
  },
  "ai": {
    "binding": "AI"
  }
}
