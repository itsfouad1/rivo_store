{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rivo-store",
	"main": "worker.mjs",
	"compatibility_date": "2026-05-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/media/*",
			"/login",
			"/register",
			"/recover",
			"/admin",
			"/account"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rivo-db",
			"database_id": "4190fb26-8a3d-49db-a6d3-9eb2f8fabaef",
			"migrations_dir": "migrations"
		},
		{
			"binding": "rivo_db",
			"database_name": "rivo_db",
			"database_id": "4190fb26-8a3d-49db-a6d3-9eb2f8fabaef",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "rivo-store-media"
		},
		{
			"bucket_name": "rivo",
			"binding": "rivo",
			"remote": true
		}
	],
	"triggers": {
		"crons": [
			"17 3 * * *"
		]
	}
}