{
  "name": "rivo-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "check": "node scripts/check-project.mjs",
    "build": "wrangler deploy --dry-run --outdir .build",
    "backup": "node scripts/backup-store.mjs"
  },
  "devDependencies": {
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
